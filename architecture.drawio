        <mxCell id="l2_chunker" parent="layer2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;PubMed Chunker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;src/build_index.py&lt;br&gt;~250 token chunks (30 overlap)&lt;br&gt;1,790 chunks tracking doc_ids&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="190" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="l2_faiss" parent="layer2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#20BEFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Embedding &amp; Vector DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;💻 &lt;b&gt;BAAI/bge-small-en-v1.5&lt;/b&gt;&lt;br&gt;💻 &lt;b&gt;faiss-cpu&lt;/b&gt; IndexFlatIP (384-d)&lt;br&gt;Peak RAM: &lt;b&gt;451.8 MB&lt;/b&gt; (under 8GB)&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="200" x="225" y="45" as="geometry" />
        </mxCell>
        <mxCell id="l2_retriever" parent="layer2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Dual Retriever&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• Normal (n=100): top-3 chunks&lt;br&gt;• Degraded (n=100): drop source doc chunks, keep 3 distractors&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="190" x="440" y="45" as="geometry" />
        </mxCell>
        <mxCell id="l2_generator" parent="layer2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#EA580C;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;RAG Generator: Groq Cloud API&lt;/b&gt;  ·  ⚡ &lt;b&gt;Model: qwen/qwen3.8-27b&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Frozen prompt: generator_v1.txt · temp: 0.0 · max_tokens: 256 · Generates 200 clinical answers (100 normal + 100 degraded) into data/exp2_rag/generated.jsonl&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="610" x="20" y="125" as="geometry" />
        </mxCell>
        <mxCell id="sublayer_ann" parent="layer2" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#6E6EDC;strokeColor=#C9C6F5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;container=1;collapsible=0;arcSize=6" value="Annotation, Agreement &amp; Adjudication Sub-layer (Gate G2)" vertex="1">
          <mxGeometry height="370" width="610" x="20" y="205" as="geometry" />
        </mxCell>
        <mxCell id="sl_export" parent="sublayer_ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Phase 6 CSV Exporter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;src/annotation.py export&lt;br&gt;RFC 4180 CSV export · seed 42 shuffle&lt;br&gt;annotator_1.csv &amp; annotator_2.csv&lt;br&gt;Conditions (normal/degraded) blinded&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="270" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sl_gate2_label" parent="sublayer_ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#888888;fontColor=#CCCCCC;fontSize=11;dashed=1;arcSize=12" value="&lt;b&gt;[PLANNED] Gate G2: Human Annotation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;(Awaiting Independent Human Labels)&lt;/i&gt;&lt;br&gt;Annotator 1: Muhammad Saad (200 pairs)&lt;br&gt;Annotator 2: Rabia Qaiser (200 pairs)&lt;br&gt;Strict compliance with Rule R1.5&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="280" x="310" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sl_kappa" parent="sublayer_ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#888888;fontColor=#CCCCCC;fontSize=11;dashed=1;arcSize=12" value="&lt;b&gt;Agreement &amp; Cohen&#x27;s Kappa&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;[PLANNED POST-LABELING]&lt;/i&gt;&lt;br&gt;python -m src.annotation kappa&lt;br&gt;Computes Cohen&#x27;s κ on 200 pairs&lt;br&gt;Exports disagreements.csv&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="270" x="20" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sl_adjudication" parent="sublayer_ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#888888;fontColor=#CCCCCC;fontSize=11;dashed=1;arcSize=12" value="&lt;b&gt;Consensus Adjudication&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;[PLANNED POST-LABELING]&lt;/i&gt;&lt;br&gt;Researchers reconcile disagreements&lt;br&gt;Populates data/exp2_rag/labeled.csv&lt;br&gt;Rule R1.6 sign-off required&lt;/font&gt;" vertex="1">
          <mxGeometry height="75" width="280" x="310" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sl_merge" parent="sublayer_ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#888888;fontColor=#CCCCCC;fontSize=11;dashed=1;arcSize=12" value="&lt;b&gt;Ground Truth Dataset Merge (src/annotation.py merge)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;[PLANNED]&lt;/i&gt; Validates labeled dataset and generates &lt;b&gt;data/exp2_rag/pairs.jsonl&lt;/b&gt;&lt;br&gt;Verifies Gate G2 class balance check (≥ 25% Hallucinated in RAG corpus; triggers extra degraded if &amp;lt;25%)&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="570" x="20" y="220" as="geometry" />
        </mxCell>
        <mxCell id="sl_note" parent="sublayer_ann" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4A4AC4;strokeColor=#C9C6F5;fontColor=#FFFFFF;fontSize=10;arcSize=12" value="&lt;font style=&quot;font-size:9px; color: #FFFFFF&quot;&gt;&lt;b&gt;Soundness Principle:&lt;/b&gt; Generator condition is blinded to human annotators. RAG hallucinations arise naturally from retrieval distractors rather than synthetic perturbation, providing an ecologically valid test of clinical verifier generalizability.&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="570" x="20" y="295" as="geometry" />
        </mxCell>
        <mxCell id="layer3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#153D1E;strokeColor=#4E9A5F;fontColor=#FFFFFF;fontSize=12;fontStyle=1;container=1;collapsible=0;arcSize=6" value="Layer 3 — Multi-Verifier Verification Plane (Shared Pipeline)" vertex="1">
          <mxGeometry height="595" width="680" x="1295" y="100" as="geometry" />
        </mxCell>
        <mxCell id="l3_coord" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Verifier Coordinator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;src/run_verifiers.py &amp; filters/base.py&lt;br&gt;Unified JSONL contract across Exp 1 &amp; Exp 2&lt;br&gt;Latency timing &amp; token accounting&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="305" x="20" y="42" as="geometry" />
        </mxCell>
        <mxCell id="l3_tune" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#20BEFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Dev Threshold Optimizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;src/tune_thresholds.py on Exp 1 Dev (100 pairs)&lt;br&gt;Frozen in results/thresholds.json:&lt;br&gt;Filter B thresh: &lt;b&gt;0.0039&lt;/b&gt; · ROUGE thresh: &lt;b&gt;0.1741&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="315" x="345" y="42" as="geometry" />
        </mxCell>
        <mxCell id="l3_rouge" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Baseline: ROUGE-L Precision&lt;/b&gt;  ·  💻 &lt;b&gt;Tool: rouge-score (Local CPU)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Lexical LCS overlap between context &amp; answer · Thresh: 0.1741 · Dev F1: 0.6667 · Test F1: 0.6667 · &lt;b&gt;Median latency: 2.5 ms&lt;/b&gt; (CPU)&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="640" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="l3_filter_b" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#9333EA;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Filter B: Local NLI Cross-Encoder&lt;/b&gt;&lt;br&gt;💻 &lt;b&gt;Tool: PyTorch CPU&lt;/b&gt; · &lt;b&gt;cross-encoder/nli-deberta-v3-small&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Sentence splitter: &lt;b&gt;pysbd&lt;/b&gt; (biomedical rule-based)&lt;br&gt;Matrix: sentences × context chunks (max 512 tokens)&lt;br&gt;Score = min_s(max_c(P(entailment))) · Thresh: 0.0039&lt;br&gt;6 CPU threads, batch=16 · &lt;b&gt;Median latency: 332.1 ms&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="410" x="20" y="198" as="geometry" />
        </mxCell>
        <mxCell id="l3_filter_b_opt" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#888888;fontColor=#CCCCCC;fontSize=11;dashed=1;arcSize=12" value="&lt;b&gt;Filter B Base Model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;[DOTTED: OPTIONAL ABLATION]&lt;/i&gt;&lt;br&gt;Model: nli-deberta-v3-base&lt;br&gt;Evaluates parameter scale vs latency on CPU&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="215" x="445" y="198" as="geometry" />
        </mxCell>
        <mxCell id="l3_filter_a" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#2563EB;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Filter A: API LLM Judge&lt;/b&gt;&lt;br&gt;☁ &lt;b&gt;Tool: Google Gemini API&lt;/b&gt; · &lt;b&gt;gemini-3.6-flash&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Prompt: judge_v1 (frozen in FROZEN.json) · temp: 0.0 · max_tokens: 1000&lt;br&gt;Extracts structured JSON: verdict (0/1), confidence (1-5), rationale&lt;br&gt;Robustness: JsonlCache request caching, RPM limit: 10, tenacity retry&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="410" x="20" y="305" as="geometry" />
        </mxCell>
        <mxCell id="l3_filter_a_runs" parent="layer3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#888888;fontColor=#CCCCCC;fontSize=11;dashed=1;arcSize=12" value="&lt;b&gt;Filter A Full Runs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;i&gt;[DOTTED: DEFERRED]&lt;/i&gt;&lt;br&gt;Deferred due to 20 RPD free tier&lt;br&gt;Awaits batch key / tier upgrade to evaluate 400 Exp 1 + 200 Exp 2 pairs&lt;/font&gt;" vertex="1">
