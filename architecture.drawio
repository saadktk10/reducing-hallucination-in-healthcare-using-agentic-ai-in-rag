        <mxCell id="p_gate_g1" parent="layer_pilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3A1010;strokeColor=#C05A5A;fontColor=#EEEEEE;fontSize=10;arcSize=12" value="&lt;b&gt;Gate G1 Decision: Fallback to Plan 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Unsupported GT (&amp;gt;10%) triggers Plan 2 protocol:&lt;br&gt;• &lt;b&gt;Experiment 2 (Healthcare RAG):&lt;/b&gt; Primary headline study (200 pairs)&lt;br&gt;• &lt;b&gt;Experiment 1 (MedHallu):&lt;/b&gt; Secondary benchmark (with caveats)&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="425" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="p_rules" parent="layer_pilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#20BEFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Integrity &amp; Governance Safeguards&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• &lt;b&gt;Rule R1.5:&lt;/b&gt; AI assistant NEVER generates or guesses labels; human judgments only&lt;br&gt;• &lt;b&gt;Rule R1.6:&lt;/b&gt; Progress past Gates G1-G6 requires explicit human sign-off in handover.md&lt;br&gt;• &lt;b&gt;Rule R4.1:&lt;/b&gt; Master seed 42 for all stratified sampling and shuffling&lt;br&gt;• &lt;b&gt;Rule R9.2:&lt;/b&gt; Mandatory session close: pytest + ruff + site_export + docs + git&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="425" x="20" y="240" as="geometry" />
        </mxCell>
        <mxCell id="p_report" parent="layer_pilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Pilot Report &amp; Artifacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;• data/pilot/pilot_report.json &amp; results/pilot/pilot_report.md&lt;br&gt;• results/pilot/metrics.json: pilot.unsupported_rate=0.46, pilot.rouge_auroc=0.4894&lt;br&gt;• Populates live website tiles automatically via results/site/numbers_of_record.json&lt;/font&gt;" vertex="1">
