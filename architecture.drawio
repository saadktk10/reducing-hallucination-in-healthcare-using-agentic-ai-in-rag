        </mxCell>
        <mxCell id="layer2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#2E2EA8;strokeColor=#8A86E0;fontColor=#FFFFFF;fontSize=12;fontStyle=1;container=1;collapsible=0;arcSize=6" value="Layer 2 — Healthcare RAG Generation Plane (Experiment 2)" vertex="1">
