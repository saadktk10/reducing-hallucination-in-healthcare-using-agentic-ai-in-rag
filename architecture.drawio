        <mxCell id="store_cache" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#4FA3C7;fontColor=#FFFFFF;fontSize=11" value="&lt;b&gt;data/cache/ &amp; data/pilot/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;JsonlCache append-only API response store&lt;br&gt;FROZEN.json prompt hashes (judge_v1, generator_v1)&lt;/font&gt;" vertex="1">
