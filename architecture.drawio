        <mxCell id="layer1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#3F3F9E;strokeColor=#8A86E0;fontColor=#FFFFFF;fontSize=12;fontStyle=1;container=1;collapsible=0;arcSize=8" value="Layer 1 — Data Preparation &amp; Stratification" vertex="1">
