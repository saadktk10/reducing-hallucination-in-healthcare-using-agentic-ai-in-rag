        <mxCell id="l1_splitter" parent="layer1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Question-Level Splitter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Split by question (0 leakage)&lt;br&gt;Dev: 50 Qs (100 pairs) for tuning&lt;br&gt;Test: 200 Qs (400 pairs) for eval&lt;br&gt;data/exp1/dev.jsonl &amp; test.jsonl&lt;/font&gt;" vertex="1">
