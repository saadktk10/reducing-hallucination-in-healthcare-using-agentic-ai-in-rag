        <mxCell id="p_spotcheck" parent="layer_pilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;Human Spot-Check (n=50)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;spotcheck_50.csv evaluated&lt;br&gt;&lt;b&gt;46.0%&lt;/b&gt; unsupported GT rate!&lt;br&gt;Risk 1 (unsupported correct) confirmed in MedHallu&lt;/font&gt;" vertex="1">
