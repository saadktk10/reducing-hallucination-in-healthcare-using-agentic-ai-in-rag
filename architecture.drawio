        <mxCell id="p_rouge_auroc" parent="layer_pilot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#AAAAAA;fontColor=#FFFFFF;fontSize=11;arcSize=12" value="&lt;b&gt;ROUGE-L Dev AUROC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;100 provisional dev pairs&lt;br&gt;AUROC = &lt;b&gt;0.4894&lt;/b&gt; (&amp;lt; 0.95)&lt;br&gt;Risk 2 (lexical shortcut) rejected; MedHallu not trivial&lt;/font&gt;" vertex="1">
